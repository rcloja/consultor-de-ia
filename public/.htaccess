# SPA hospedado em https://atendenteai.com.br/consultor/
# Coloque o conteudo da pasta dist/ dentro de /public_html/consultor/
# (este arquivo .htaccess deve ficar em /public_html/consultor/.htaccess)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /consultor/

  # Arquivos e diretorios reais sao servidos como estao (assets, imagens, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer outra rota cai no index.html do SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Garante MIME types corretos (alguns Apache antigos servem .css/.js como text/plain)
<IfModule mod_mime.c>
  AddType text/css            .css
  AddType application/javascript .js .mjs
  AddType application/json    .json
  AddType image/svg+xml       .svg
  AddType font:woff2          .woff2
</IfModule>

# Cache agressivo nos assets versionados (nomes com hash)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml       "access plus 1 year"
  ExpiresByType image/png           "access plus 1 year"
  ExpiresByType image/jpeg          "access plus 1 year"
  ExpiresByType font/woff2          "access plus 1 year"
</IfModule>

# index.html nunca pode ser cacheado, senao novas versoes nao aparecem
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
